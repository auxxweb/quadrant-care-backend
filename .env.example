NODE_ENV=development
PORT=5050
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quadrant_care?retryWrites=true&w=majority
JWT_SECRET=dev-quadrant-care-access-secret-change-me-now-32chars
JWT_REFRESH_SECRET=dev-quadrant-care-refresh-secret-change-me-now
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Quadrant Care <noreply@quadrantcare.local>
CLIENT_URL=http://localhost:5173
# local (files under UPLOAD_DIR) or s3 (private bucket; /uploads redirects to presigned URLs)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=
AWS_REGION=
# Optional key prefix inside the bucket, e.g. quadrant/prod
AWS_S3_PREFIX=
S3_URL_EXPIRY_SECONDS=300
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
COOKIE_SECURE=false

# Comma-separated list. The first URL is used in email links; all of them are allowed for CORS.
# e.g. CLIENT_URL=https://auxxweb.github.io/quadrant-care-frontend,http://localhost:5173
# Use "none" when the frontend and API are on different sites (e.g. GitHub Pages + a separate API host).
COOKIE_SAMESITE=lax
