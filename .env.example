NODE_ENV=development
PORT=5050
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quadrant_care?retryWrites=true&w=majority
JWT_SECRET=dev-quadrant-care-access-secret-change-me-now-32chars
JWT_REFRESH_SECRET=dev-quadrant-care-refresh-secret-change-me-now
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Quadrant Care <noreply@quadrantcare.local>
CLIENT_URL=http://localhost:5173
STORAGE_PROVIDER=local
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_BUCKET=
AWS_REGION=
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
COOKIE_SECURE=false
